<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>Preview - Tile Server</title>

  <link rel="stylesheet" href="{{base_url}}/css/index.css" /></head>

<body>
  <section>
    <h1 class="title">Tile server preview</h1>

    <div class="tabs">
      <div class="tab active" onclick="switchTab(event, 'styles-tab')">STYLES ({{style_count}})</div>
      <div class="tab" onclick="switchTab(event, 'geojsons-tab')">GEOJSONS ({{geojson_count}})</div>
      <div class="tab" onclick="switchTab(event, 'geojson_groups-tab')">GEOJSON GROUPS ({{geojson_group_count}})</div>
      <div class="tab" onclick="switchTab(event, 'datas-tab')">DATAS ({{data_count}})</div>
      <div class="tab" onclick="switchTab(event, 'fonts-tab')">FONTS ({{font_count}})</div>
      <div class="tab" onclick="switchTab(event, 'sprites-tab')">SPRITES ({{sprite_count}})</div>
      <div class="tab" onclick="switchTab(event, 'actions-tab')">ACTIONS</div>
      <div class="tab" onclick="switchTab(event, 'configs-tab')">CONFIGS</div>
    </div>

    <div id="styles-tab" class="tab-content active"></div>
    <div id="geojsons-tab" class="tab-content"></div>
    <div id="geojson_groups-tab" class="tab-content"></div>
    <div id="datas-tab" class="tab-content"></div>
    <div id="fonts-tab" class="tab-content"></div>
    <div id="sprites-tab" class="tab-content"></div>
    <div id="actions-tab" class="tab-content"></div>
    <div id="configs-tab" class="tab-content"></div>
  </section>

  {{#*inline "jsonDialog"}}
    <dialog id="{{dialogId}}">
      <form id="{{formId}}" method="dialog">
        <label for="{{inputId}}">Enter JSON:</label>
        <div id="{{inputId}}" class="json-dialog-editor" data-json-editor></div>
        <div class="dialog">
          <button type="submit" class="btn-primary">{{submitText}}</button>
          <button type="button" class="btn-secondary" onclick="closeDialog('{{dialogId}}')">Cancel</button>
        </div>
      </form>
    </dialog>
  {{/inline}}

  {{> jsonDialog dialogId="updateConfigDialog" formId="updateConfigForm" inputId="updateConfigInput" submitText="OK"}}
  {{> jsonDialog dialogId="updateSeedDialog" formId="updateSeedForm" inputId="updateSeedInput" submitText="OK"}}
  {{> jsonDialog dialogId="updateCleanUpDialog" formId="updateCleanUpForm" inputId="updateCleanUpInput" submitText="OK"}}
  {{> jsonDialog dialogId="deleteConfigDialog" formId="deleteConfigForm" inputId="deleteConfigInput" submitText="OK"}}
  {{> jsonDialog dialogId="deleteSeedDialog" formId="deleteSeedForm" inputId="deleteSeedInput" submitText="OK"}}
  {{> jsonDialog dialogId="deleteCleanUpDialog" formId="deleteCleanUpForm" inputId="deleteCleanUpInput" submitText="OK"}}
  {{> jsonDialog dialogId="exportRenderDialog" formId="exportRenderForm" inputId="exportRenderInput" submitText="Export"}}
  {{> jsonDialog dialogId="exportImageDialog" formId="exportImageForm" inputId="exportImageInput" submitText="Export"}}
  {{> jsonDialog dialogId="exportDataDialog" formId="exportDataForm" inputId="exportDataInput" submitText="Export"}}

  <a href="#" class="back-to-top" onclick="scrollToTop(event)">Back to top</a>

  <link rel="stylesheet" href="{{base_url}}/css/json-editor.css" />
  <script src="{{base_url}}/js/json-editor.js"></script>
  <script>
    const baseURL = {{{js base_url}}};
    const emptyImageURL = `${baseURL}/images/placeholder.png`;
    const jsonEditors = {};
    document.querySelectorAll("[data-json-editor]").forEach((element) => {
      jsonEditors[element.id] = new JSONEditor(element);
    });

    function getJSONText(inputId) {
      try {
        return jsonEditors[inputId].getText();
      } catch (error) {
        alert(error.message);
        return null;
      }
    }

    function escapeHTML(value) {
      return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#39;");
    }

    function escapeAttr(value) {
      return escapeHTML(value);
    }

    function pathSegment(value) {
      return encodeURIComponent(String(value ?? ""));
    }

    function domId(prefix, value) {
      return `${prefix}_${String(value ?? "").replaceAll(/[^a-zA-Z0-9_-]/g, "_")}`;
    }

    function renderButton({ text, href = "#", onClick }) {
      return `<a class="btn" href="${escapeAttr(href)}"${onClick ? ` onclick="${escapeAttr(onClick)}"` : ""}>${escapeHTML(text)}</a>`;
    }

    function renderStaticItem({ title, description, buttons }) {
      const action = buttons[0] || {};
      const href = escapeAttr(action.href || "#");
      const onClick = action.onClick ? ` onclick="${escapeAttr(action.onClick)}"` : "";
      return `
        <a class="static-action" href="${href}"${onClick}>
          <span class="static-action__title">${escapeHTML(title)}</span>
          <span class="static-action__description">${escapeHTML(description)}</span>
        </a>
      `;
    }

    function renderStaticBox(items) {
      return `<div class="static-box">${items.map(renderStaticItem).join("")}</div>`;
    }

    function requestGET(url, message) {
      fetch(url, {
        method: "GET",
      })
        .then(() => alert(message))
        .catch(handleError);
    }

    function submitJSONDialog({ dialogId, formId, inputId, url, method, message, loadUrl }) {
      document.getElementById(dialogId).showModal();
      if (loadUrl) {
        fetch(loadUrl)
          .then((response) => {
            if (!response.ok) throw new Error(`Failed to load JSON: \${response.status}`);
            return response.json();
          })
          .then((value) => jsonEditors[inputId].setValue(value))
          .catch(handleError);
      }

      document.getElementById(formId).onsubmit = (event) => {
        event.preventDefault();
        const body = getJSONText(inputId);
        if (body === null) return;

        fetch(url, {
          method,
          headers: {
            "content-type": "application/json",
          },
          body
        })
          .then(() => {
            alert(message);

            closeDialog(dialogId);
          })
          .catch(handleError);
      };
    }

    const actionItems = [
      { title: "Cancel sync", description: "Cancel cleanup/seed tasks", buttons: [{ text: "Cancel sync", onClick: "handleAction(event, 'cancel')" }] },
      { title: "Sync all", description: "Start cleanup/seed tasks", buttons: [{ text: "Sync all", onClick: "handleAction(event, 'all')" }] },
      { title: "Clean styles", description: "Start cleanup styles", buttons: [{ text: "Clean styles", onClick: "handleAction(event, 'cleanUpStyles')" }] },
      { title: "Clean geojsons", description: "Start cleanup geojsons", buttons: [{ text: "Clean geojsons", onClick: "handleAction(event, 'cleanUpGeoJSONs')" }] },
      { title: "Clean datas", description: "Start cleanup datas", buttons: [{ text: "Clean datas", onClick: "handleAction(event, 'cleanUpDatas')" }] },
      { title: "Clean sprites", description: "Start cleanup sprites", buttons: [{ text: "Clean sprites", onClick: "handleAction(event, 'cleanUpSprites')" }] },
      { title: "Clean fonts", description: "Start cleanup fonts", buttons: [{ text: "Clean fonts", onClick: "handleAction(event, 'cleanUpFonts')" }] },
      { title: "Seed styles", description: "Start seed styles", buttons: [{ text: "Seed styles", onClick: "handleAction(event, 'seedStyles')" }] },
      { title: "Seed geojsons", description: "Start seed geojsons", buttons: [{ text: "Seed geojsons", onClick: "handleAction(event, 'seedGeoJSONs')" }] },
      { title: "Seed datas", description: "Start seed datas", buttons: [{ text: "Seed datas", onClick: "handleAction(event, 'seedDatas')" }] },
      { title: "Seed sprites", description: "Start seed sprites", buttons: [{ text: "Seed sprites", onClick: "handleAction(event, 'seedSprites')" }] },
      { title: "Seed fonts", description: "Start seed fonts", buttons: [{ text: "Seed fonts", onClick: "handleAction(event, 'seedFonts')" }] },
      { title: "Summary service", description: "Summary service", buttons: [{ text: "View", href: `${baseURL}/summary?type=service` }] },
      { title: "Summary seed", description: "Summary seed", buttons: [{ text: "View", href: `${baseURL}/summary?type=seed` }] },
      { title: "Export image", description: "Export static image", buttons: [{ text: "Export", onClick: "handleExportImage(event)" }] },
    ];

    const configItems = [
      { title: "Swagger", description: "View swagger", buttons: [{ text: "View", href: `${baseURL}/swagger` }] },
      { title: "View config JSON", description: "View config.json content", buttons: [{ text: "View", href: `${baseURL}/config?type=config` }] },
      { title: "View seed JSON", description: "View seed.json content", buttons: [{ text: "View", href: `${baseURL}/config?type=seed` }] },
      { title: "View cleanup JSON", description: "View cleanup.json content", buttons: [{ text: "View", href: `${baseURL}/config?type=cleanup` }] },
      { title: "Update config JSON", description: "Update config.json content", buttons: [{ text: "Update", onClick: "handleConfig(event, 'showUpdateConfig')" }] },
      { title: "Update seed JSON", description: "Update seed.json content", buttons: [{ text: "Update", onClick: "handleConfig(event, 'showUpdateSeed')" }] },
      { title: "Update cleanup JSON", description: "Update cleanup.json content", buttons: [{ text: "Update", onClick: "handleConfig(event, 'showUpdateCleanUp')" }] },
      { title: "Delete config JSON", description: "Delete config.json content", buttons: [{ text: "Delete", onClick: "handleConfig(event, 'showDeleteConfig')" }] },
      { title: "Delete seed JSON", description: "Delete seed.json content", buttons: [{ text: "Delete", onClick: "handleConfig(event, 'showDeleteSeed')" }] },
      { title: "Delete cleanup JSON", description: "Delete cleanup.json content", buttons: [{ text: "Delete", onClick: "handleConfig(event, 'showDeleteCleanUp')" }] },
      { title: "Kill", description: "Kill server", buttons: [{ text: "Kill server", onClick: "handleConfig(event, 'kill')" }] },
      { title: "Restart", description: "Restart server", buttons: [{ text: "Restart server", onClick: "handleConfig(event, 'restart')" }] },
    ];

    const taskActions = {
      all: { url: `${baseURL}/tasks/start?seedStyles=true&cleanUpStyles=true&cleanUpDatas=true&seedDatas=true&seedGeoJSONs=true&cleanUpGeoJSONs=true&seedSprites=true&cleanUpSprites=true&seedFonts=true&cleanUpFonts=true&restart=true`, message: "Starting cleanup/seed tasks..." },
      cleanUpStyles: { url: `${baseURL}/tasks/start?cleanUpStyles=true&restart=true`, message: "Starting start cleanup styles..." },
      cleanUpGeoJSONs: { url: `${baseURL}/tasks/start?cleanUpGeoJSONs=true&restart=true`, message: "Starting start cleanup geojsons..." },
      cleanUpDatas: { url: `${baseURL}/tasks/start?cleanUpDatas=true&restart=true`, message: "Starting cleanup datas..." },
      cleanUpSprites: { url: `${baseURL}/tasks/start?cleanUpSprites=true&restart=true`, message: "Starting cleanup sprites..." },
      cleanUpFonts: { url: `${baseURL}/tasks/start?cleanUpFonts=true&restart=true`, message: "Starting cleanup fonts..." },
      seedStyles: { url: `${baseURL}/tasks/start?seedStyles=true&restart=true`, message: "Starting seed styles..." },
      seedGeoJSONs: { url: `${baseURL}/tasks/start?seedGeoJSONs=true&restart=true`, message: "Starting seed geojsons..." },
      seedDatas: { url: `${baseURL}/tasks/start?seedDatas=true&restart=true`, message: "Starting seed datas..." },
      seedSprites: { url: `${baseURL}/tasks/start?seedSprites=true&restart=true`, message: "Starting seed sprites..." },
      seedFonts: { url: `${baseURL}/tasks/start?seedFonts=true&restart=true`, message: "Starting seed fonts..." },
      cancel: { url: `${baseURL}/tasks/cancel`, message: "Canceling cleanup/seed tasks..." },
    };

    const configActions = {
      restart: { url: `${baseURL}/restart?type=restart`, message: "Server restarted successfully!" },
      kill: { url: `${baseURL}/restart?type=kill`, message: "Server killed successfully!" },
    };

    const configDialogActions = {
      showUpdateConfig: {
        dialogId: "updateConfigDialog",
        formId: "updateConfigForm",
        inputId: "updateConfigInput",
        loadUrl: `${baseURL}/config?type=config`,
        url: `${baseURL}/config?type=config&restart=true`,
        method: "PUT",
        message: "Updating config...",
      },
      showUpdateSeed: {
        dialogId: "updateSeedDialog",
        formId: "updateSeedForm",
        inputId: "updateSeedInput",
        loadUrl: `${baseURL}/config?type=seed`,
        url: `${baseURL}/config?type=seed&restart=true`,
        method: "PUT",
        message: "Updating seed...",
      },
      showUpdateCleanUp: {
        dialogId: "updateCleanUpDialog",
        formId: "updateCleanUpForm",
        inputId: "updateCleanUpInput",
        loadUrl: `${baseURL}/config?type=cleanup`,
        url: `${baseURL}/config?type=cleanup&restart=true`,
        method: "PUT",
        message: "Updating cleanup...",
      },
      showDeleteConfig: {
        dialogId: "deleteConfigDialog",
        formId: "deleteConfigForm",
        inputId: "deleteConfigInput",
        url: `${baseURL}/config?type=config&restart=true`,
        method: "DELETE",
        message: "Deleting config...",
      },
      showDeleteSeed: {
        dialogId: "deleteSeedDialog",
        formId: "deleteSeedForm",
        inputId: "deleteSeedInput",
        url: `${baseURL}/config?type=seed&restart=true`,
        method: "DELETE",
        message: "Deleting seed...",
      },
      showDeleteCleanUp: {
        dialogId: "deleteCleanUpDialog",
        formId: "deleteCleanUpForm",
        inputId: "deleteCleanUpInput",
        url: `${baseURL}/config?type=cleanup&restart=true`,
        method: "DELETE",
        message: "Deleting cleanup...",
      },
    };

    function toggleURL(id, event) {
      event.preventDefault();

      const el = document.getElementById(id);

      if (el.style.display === "none") {
        el.style.display = "inline-block";
      } else {
        el.style.display = "none";
      }
    }

    function copyToClipboard(el) {
      el.select();

      document.execCommand("copy");

      setTimeout(() => {
        el.style.display = "none";
      }, 200);
    }

    function scrollToTop(event) {
      event.preventDefault();

      window.scrollTo({
        top: 0,
        behavior: "smooth",
      });
    }

    function switchTab(event, tabId) {
      document.querySelectorAll(".tab").forEach(tab => {
        tab.classList.remove("active");
      });

      document.querySelectorAll(".tab-content").forEach(content => {
        content.classList.remove("active");
      });

      event.currentTarget.classList.add("active");

      document.getElementById(tabId).classList.add("active");

      renderContents(tabId);
    }

    function renderContents(tabId) {
      const innerHTML = document.querySelector(`#${tabId}`).innerHTML.trim();

      if (tabId === "styles-tab" && !innerHTML) {
        document.querySelector("#styles-tab").innerHTML = `
          <div class="box">
            {{#each styles}}
              <div class="item">
                {{#if thumbnail}}<img src="${escapeAttr({{{js thumbnail}}})}" alt="${escapeAttr({{{js name}}})} preview" />{{else}}<img src="${emptyImageURL}" alt="${escapeAttr({{{js name}}})} preview" />{{/if}}
                <div class="details">
                  <h3 class="name">${escapeHTML({{{js name}}})}</h3>
                  <p>identifier: ${escapeHTML({{{js @key}}})}</p>
                  <p>cache: {{#if cache}}<span style="color:green;">true</span>{{else}}<span style="color:red;">false</span>{{/if}}</p>
                  <p class="services">
                    services: <a href="${baseURL}/styles/${pathSegment({{{js @key}}})}/style.json">StyleJSON</a>
                    {{#if thumbnail}}
                      | <a href="${baseURL}/styles/${pathSegment({{{js @key}}})}.json">TileJSON</a>
                      | <a href="${baseURL}/styles/${pathSegment({{{js @key}}})}/wmts.xml">WMTS</a>
                      | <a href="#" data-target="${escapeAttr(domId("xyz_style", {{{js @key}}}))}" onclick="toggleURL(this.dataset.target, event)">XYZ</a>
                      <input id="${escapeAttr(domId("xyz_style", {{{js @key}}}))}" style="display:none;cursor:pointer;" type="text" value="${baseURL}/styles/${pathSegment({{{js @key}}})}/{z}/{x}/{y}.png" onclick="copyToClipboard(this)" />
                    {{/if}}
                  </p>
                </div>
                <div class="viewers">
                    <a class="btn" href="${baseURL}/styles/${pathSegment({{{js @key}}})}/?vector${escapeAttr({{{js viewer_hash}}})}">Client Render</a>
                    {{#if thumbnail}}
                      <a class="btn" href="${baseURL}/styles/${pathSegment({{{js @key}}})}/?raster${escapeAttr({{{js viewer_hash}}})}">Backend Render</a>
                      {{#if cancel_render}}
                      <a class="btn" href="#" data-id="${escapeAttr({{{js @key}}})}" onclick="handleExportRender(event, this.dataset.id, 'cancel')">Cancel Render</a>
                      {{else}}
                      <a class="btn" href="#" data-id="${escapeAttr({{{js @key}}})}" onclick="handleExportRender(event, this.dataset.id, 'export')">Export Render</a>
                      {{/if}}
                    {{/if}}
                </div>
              </div>
            {{/each}}
          </div>
        `;
      } if (tabId === "geojsons-tab" && !innerHTML) {
        document.querySelector("#geojsons-tab").innerHTML = `
          <div class="box">
            {{#each geojsons}}
              <div class="item">
                <img src="${emptyImageURL}" alt="Empty image" />
                <div class="details">
                  <h3 class="name">${escapeHTML({{{js layer}}})}</h3>
                  <p>identifier: ${escapeHTML({{{js layer}}})}</p>
                  <p>group: ${escapeHTML({{{js group}}})}</p>
                  <p>layer: ${escapeHTML({{{js layer}}})}</p>
                  <p>cache: {{#if cache}}<span style="color:green;">true</span>{{else}}<span style="color:red;">false</span>{{/if}}</p>
                  <p class="services">
                    services: <a href="${baseURL}/geojsons/${pathSegment({{{js group}}})}/${pathSegment({{{js layer}}})}.geojson">GeoJSON</a>
                    | <a href="${baseURL}/geojsons/${pathSegment({{{js group}}})}/${pathSegment({{{js layer}}})}.json">INFO</a>
                  </p>
                </div>
                <div class="viewers">
                  <a class="btn" href="${baseURL}/geojsons/${pathSegment({{{js group}}})}/${pathSegment({{{js layer}}})}/">Inspect</a>
                </div>
              </div>
            {{/each}}
          </div>
        `;
      } if (tabId === "geojson_groups-tab" && !innerHTML) {
        document.querySelector("#geojson_groups-tab").innerHTML = `
          <div class="box">
            {{#each geojson_groups}}
              <div class="item">
                <img src="${emptyImageURL}" alt="Empty image" />
                <div class="details">
                  <h3 class="name">${escapeHTML({{{js @key}}})}</h3>
                  <p>identifier: ${escapeHTML({{{js @key}}})}</p>
                  <p class="services">
                    services: <a href="${baseURL}/geojsons/${pathSegment({{{js @key}}})}.json">INFO</a>
                  </p>
                </div>
                <div class="viewers">
                  <a class="btn" href="${baseURL}/geojsons/${pathSegment({{{js @key}}})}/">Inspect</a>
                </div>
              </div>
            {{/each}}
          </div>
        `;
      } else if (tabId === "datas-tab" && !innerHTML) {
        document.querySelector("#datas-tab").innerHTML = `
          <div class="box">
            {{#each datas}}
              <div class="item">
                {{#if thumbnail}}<img src="${escapeAttr({{{js thumbnail}}})}" alt="${escapeAttr({{{js name}}})} preview" />{{else}}<img src="${emptyImageURL}" alt="${escapeAttr({{{js name}}})} preview" />{{/if}}
                <div class="details">
                  <h3 class="name">${escapeHTML({{{js name}}})}</h3>
                  <p>identifier: ${escapeHTML({{{js @key}}})}</p>
                  <p>type: {{#if thumbnail}}raster{{else}}vector{{/if}} | ext: ${escapeHTML({{{js source_type}}})}</p>
                  <p>cache: {{#if cache}}<span style="color:green;">true</span>{{else}}<span style="color:red;">false</span>{{/if}}</p>
                  <p class="services">
                    services: <a href="${baseURL}/datas/${pathSegment({{{js @key}}})}.json">TileJSON</a>
                      | <a href="#" data-target="${escapeAttr(domId("xyz_data", {{{js @key}}}))}" onclick="toggleURL(this.dataset.target, event)">XYZ</a>
                      <input id="${escapeAttr(domId("xyz_data", {{{js @key}}}))}" style="display:none;cursor:pointer;" type="text" value="${baseURL}/datas/${pathSegment({{{js @key}}})}/{z}/{x}/{y}.${pathSegment({{{js format}}})}" onclick="copyToClipboard(this)" />
                  </p>
                </div>
                <div class="viewers">
                  {{#if thumbnail}}
                  <a class="btn" href="${baseURL}/datas/${pathSegment({{{js @key}}})}/${escapeAttr({{{js viewer_hash}}})}">View</a>
                  {{else}}
                  <a class="btn" href="${baseURL}/datas/${pathSegment({{{js @key}}})}/${escapeAttr({{{js viewer_hash}}})}">Inspect</a>
                  {{/if}}
                  {{#if cancel_export}}
                  <a class="btn" href="#" data-id="${escapeAttr({{{js @key}}})}" onclick="handleExportData(event, this.dataset.id, 'cancel')">Cancel Export</a>
                  {{else}}
                  <a class="btn" href="#" data-id="${escapeAttr({{{js @key}}})}" onclick="handleExportData(event, this.dataset.id, 'export')">Export Data</a>
                  {{/if}}
                </div>
              </div>
            {{/each}}
          </div>
        `;
      } else if (tabId === "fonts-tab" && !innerHTML) {
        document.querySelector("#fonts-tab").innerHTML = `
          <div class="box">
            {{#each fonts}}
              <div class="item">
                <img src="${emptyImageURL}" alt="Empty image" />
                <div class="details">
                  <h3 class="name">${escapeHTML({{{js @key}}})}</h3>
                  <p>identifier: ${escapeHTML({{{js @key}}})}</p>
                  <p>cache: {{#if cache}}<span style="color:green;">true</span>{{else}}<span style="color:red;">false</span>{{/if}}</p>
                  <p class="services">
                    services: <a href="#" data-target="${escapeAttr(domId("font", {{{js @key}}}))}" onclick="toggleURL(this.dataset.target, event)">URL</a>
                    <input id="${escapeAttr(domId("font", {{{js @key}}}))}" style="display:none;cursor:pointer;" type="text" value="${baseURL}/fonts/${pathSegment({{{js @key}}})}/{range}.pbf" onclick="copyToClipboard(this)" />
                  </p>
                </div>
              </div>
            {{/each}}
          </div>
        `;
      } else if (tabId === "sprites-tab" && !innerHTML) {
        document.querySelector("#sprites-tab").innerHTML = `
          <div class="box">
            {{#each sprites}}
              <div class="item">
                <img src="${baseURL}/sprites/${pathSegment({{{js @key}}})}/sprite.png" alt="${escapeAttr({{{js @key}}})} preview" />
                <div class="details">
                  <h3 class="name">${escapeHTML({{{js @key}}})}</h3>
                  <p>identifier: ${escapeHTML({{{js @key}}})}</p>
                  <p>cache: {{#if cache}}<span style="color:green;">true</span>{{else}}<span style="color:red;">false</span>{{/if}}</p>
                  <p class="services">
                    services: <a href="${baseURL}/sprites/${pathSegment({{{js @key}}})}/sprite.json">JSON</a>
                    | <a href="${baseURL}/sprites/${pathSegment({{{js @key}}})}/sprite.png">PNG</a>
                    | <a href="#" data-target="${escapeAttr(domId("sprite", {{{js @key}}}))}" onclick="toggleURL(this.dataset.target, event)">URL</a>
                    <input id="${escapeAttr(domId("sprite", {{{js @key}}}))}" style="display:none;cursor:pointer;" type="text" value="${baseURL}/sprites/${pathSegment({{{js @key}}})}/sprite" onclick="copyToClipboard(this)" />
                  </p>
                </div>
              </div>
            {{/each}}
          </div>
        `;
      } else if (tabId === "actions-tab" && !innerHTML) {
        document.querySelector("#actions-tab").innerHTML = renderStaticBox(actionItems);
      } else if (tabId === "configs-tab" && !innerHTML) {
        document.querySelector("#configs-tab").innerHTML = renderStaticBox(configItems);
      }
    }

    function handleError(error) {
      if (error.response) {
        alert(`Error: Status code: ${error.response.status} - ${error.response.statusText}`);
      } else if (error.request) {
        alert("No response received");
      } else {
        alert(`Error: ${error.message}`);
      }
    }

    function handleAction(event, action) {
      event.preventDefault();

      const taskAction = taskActions[action];

      if (taskAction) {
        requestGET(taskAction.url, taskAction.message);
      }
    }

    function handleConfig(event, action) {
      event.preventDefault();

      const configAction = configActions[action];
      const configDialogAction = configDialogActions[action];

      if (configAction) {
        requestGET(configAction.url, configAction.message);
      } else if (configDialogAction) {
        submitJSONDialog(configDialogAction);
      }
    }

    function handleExportRender(event, styleID, action) {
      event.preventDefault();

      if (action === "export") {
        document.getElementById("exportRenderDialog").showModal();

        document.getElementById("exportRenderForm").onsubmit = (event) => {
          event.preventDefault();
          const body = getJSONText("exportRenderInput");
          if (body === null) return;

          fetch(`${baseURL}/exports/style-render/${styleID}`, {
            method: "POST",
            headers: {
              "content-type": "application/json",
            },
            body
          })
            .then(() => {
              alert("Exporting render style...");

              closeDialog("exportRenderDialog");
            })
            .catch(handleError);
        }
      } else if (action === "cancel") {
        let maxRetries = 5;

        function tryFetch() {
          fetch(`${baseURL}/exports/style-render/${styleID}?cancel=true`, {
            method: "GET",
          })
            .then(() => alert("Canceling render style..."))
            .catch(handleError);
        }

        tryFetch();
      }
    }

    function handleExportImage(event) {
      event.preventDefault();

      document.getElementById("exportImageDialog").showModal();

        document.getElementById("exportImageForm").onsubmit = (event) => {
          event.preventDefault();
          const body = getJSONText("exportImageInput");
          if (body === null) return;

          fetch(`${baseURL}/renders/stylejson`, {
          method: "POST",
          headers: {
            "content-type": "application/json",
          },
            body
        })
          .then(async (response) => {
            const contentDisposition = response.headers.get("content-disposition");

            if (contentDisposition) {
              const url = window.URL.createObjectURL(await response.blob());

              const a = document.createElement("a");
              a.href = url;
              a.download = contentDisposition.split("filename=")[1].replace(/"/g, "");
              document.body.appendChild(a);
              a.click();
              a.remove();

              window.URL.revokeObjectURL(url);
            } else {
              alert(JSON.stringify(await response.json(), null, 2));
            }

            closeDialog("exportImageDialog");
          })
          .catch(handleError);
      }
    }

    function handleExportData(event, dataID, action) {
      event.preventDefault();

      if (action === "export") {
        document.getElementById("exportDataDialog").showModal();

        document.getElementById("exportDataForm").onsubmit = (event) => {
          event.preventDefault();
          const body = getJSONText("exportDataInput");
          if (body === null) return;

          fetch(`${baseURL}/exports/data/${dataID}`, {
            method: "POST",
            headers: {
              "content-type": "application/json",
            },
            body
          })
            .then(() => {
              alert("Exporting data...");

              closeDialog("exportDataDialog");
            })
            .catch(handleError);
        }
      } else if (action === "cancel") {
        let maxRetries = 5;

        function tryFetch() {
          fetch(`${baseURL}/exports/data/${dataID}?cancel=true`, {
            method: "GET",
          })
            .then(() => alert("Canceling export data..."))
            .catch(handleError);
        }

        tryFetch();
      }
    }

    function closeDialog(dialog) {
      document.getElementById(dialog).close();
    }

    window.onload = function () {
      renderContents("styles-tab");
    };

    window.addEventListener("scroll", () => {
      const backToTopButton = document.querySelector(".back-to-top");

      if (window.scrollY > 200) {
        backToTopButton.style.display = "flex";
      } else {
        backToTopButton.style.display = "none";
      }
    });
  </script>
</body>

</html>
