<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>Preview - Tile Server</title>

  <link rel="stylesheet" href="{{base_url}}/css/index.css" /></head>

<body>
  <section>
    <h1 class="title">Tile server preview</h1>

    <div class="tabs">
      <div class="tab active" onclick="switchTab(event, 'styles-tab')">STYLES ({{style_count}})</div>
      <div class="tab" onclick="switchTab(event, 'geojsons-tab')">GEOJSONS ({{geojson_count}})</div>
      <div class="tab" onclick="switchTab(event, 'geojson_groups-tab')">GEOJSON GROUPS ({{geojson_group_count}})</div>
      <div class="tab" onclick="switchTab(event, 'datas-tab')">DATAS ({{data_count}})</div>
      <div class="tab" onclick="switchTab(event, 'fonts-tab')">FONTS ({{font_count}})</div>
      <div class="tab" onclick="switchTab(event, 'sprites-tab')">SPRITES ({{sprite_count}})</div>
      <div class="tab" onclick="switchTab(event, 'sync-tab')">SYNC</div>
      <div class="tab" onclick="switchTab(event, 'configs-tab')">CONFIGS</div>
      <div class="tab" onclick="switchTab(event, 'utility-tab')">UTILITY</div>
    </div>

    <div id="styles-tab" class="tab-content active"></div>
    <div id="geojsons-tab" class="tab-content"></div>
    <div id="geojson_groups-tab" class="tab-content"></div>
    <div id="datas-tab" class="tab-content"></div>
    <div id="fonts-tab" class="tab-content"></div>
    <div id="sprites-tab" class="tab-content"></div>
    <div id="sync-tab" class="tab-content"></div>
    <div id="configs-tab" class="tab-content"></div>
    <div id="utility-tab" class="tab-content"></div>
  </section>

  {{#*inline "jsonDialog"}}
    <dialog id="{{dialogId}}">
      <form id="{{formId}}" method="dialog">
        <label for="{{inputId}}">Enter JSON:</label>
        <div id="{{inputId}}" class="json-dialog-editor" data-json-editor></div>
        <div class="dialog">
          <button type="submit" class="btn-primary">{{submitText}}</button>
          <button type="button" class="btn-secondary" onclick="closeDialog('{{dialogId}}')">Cancel</button>
        </div>
      </form>
    </dialog>
  {{/inline}}

  <dialog id="configDialog">
    <form id="configForm" method="dialog">
      <h2>Update config</h2>
      <label for="configTypeInput">Type</label>
      <select id="configTypeInput" name="type">
        <option value="config">Config</option>
        <option value="seed">Seed</option>
        <option value="cleanup">Cleanup</option>
      </select>
      <div id="selectedConfigInput" class="json-dialog-editor" data-json-editor></div>
      <div class="dialog">
        <button type="submit" class="btn-primary">Confirm</button>
        <button type="button" class="btn-secondary" onclick="closeDialog('configDialog')">Cancel</button>
      </div>
    </form>
  </dialog>
  {{> jsonDialog dialogId="exportRenderDialog" formId="exportRenderForm" inputId="exportRenderInput" submitText="Confirm"}}
  {{> jsonDialog dialogId="exportImageDialog" formId="exportImageForm" inputId="exportImageInput" submitText="Confirm"}}
  {{> jsonDialog dialogId="exportDataDialog" formId="exportDataForm" inputId="exportDataInput" submitText="Confirm"}}
  <dialog id="syncDialog">
    <form id="syncForm" method="dialog">
      <h2 id="syncDialogTitle">Sync</h2>
      <label for="syncTypeInput">Type</label>
      <select id="syncTypeInput" name="type"></select>
      <label for="syncIDInput">ID</label>
      <select id="syncIDInput" name="id"></select>
      <div class="dialog">
        <button type="submit" class="btn-primary" id="syncSubmitButton">Confirm</button>
        <button type="button" class="btn-secondary" onclick="closeDialog('syncDialog')">Cancel</button>
      </div>
    </form>
  </dialog>

  <a href="#" class="back-to-top" onclick="scrollToTop(event)">Back to top</a>

  <link rel="stylesheet" href="{{base_url}}/css/json-editor.css" />
  <script src="{{base_url}}/js/json-editor.js"></script>
  <script>
    const baseURL = {{{js base_url}}};
    const syncTargets = {{{js sync_targets}}};
    const emptyImageURL = `${baseURL}/images/placeholder.png`;
    const jsonEditors = {};
    document.querySelectorAll("[data-json-editor]").forEach((element) => {
      jsonEditors[element.id] = new JSONEditor(element);
    });

    function getJSONText(inputId) {
      try {
        return jsonEditors[inputId].getText();
      } catch (error) {
        alert(error.message);
        return null;
      }
    }

    function escapeHTML(value) {
      return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#39;");
    }

    function escapeAttr(value) {
      return escapeHTML(value);
    }

    function pathSegment(value) {
      return encodeURIComponent(String(value ?? ""));
    }

    function domId(prefix, value) {
      return `${prefix}_${String(value ?? "").replaceAll(/[^a-zA-Z0-9_-]/g, "_")}`;
    }

    function renderButton({ text, href = "#", onClick }) {
      return `<a class="btn" href="${escapeAttr(href)}"${onClick ? ` onclick="${escapeAttr(onClick)}"` : ""}>${escapeHTML(text)}</a>`;
    }

    function renderStaticItem({ title, description, buttons }) {
      const action = buttons[0] || {};
      const href = escapeAttr(action.href || "#");
      const onClick = action.onClick ? ` onclick="${escapeAttr(action.onClick)}"` : "";
      return `
        <a class="static-action" href="${href}"${onClick}>
          <span class="static-action__title">${escapeHTML(title)}</span>
          <span class="static-action__description">${escapeHTML(description)}</span>
        </a>
      `;
    }

    function renderStaticBox(items) {
      return `<div class="static-box">${items.map(renderStaticItem).join("")}</div>`;
    }

    function requestGET(url, message) {
      fetch(url, {
        method: "GET",
      })
        .then(() => alert(message))
        .catch(handleError);
    }

    const syncItems = [
      { title: "Cancel sync", description: "Cancel queued or running synchronization", buttons: [{ text: "Cancel sync", onClick: "openSyncDialog(event, 'cancel')" }] },
      { title: "Sync", description: "Run cleanup and seed synchronization", buttons: [{ text: "Sync", onClick: "openSyncDialog(event, 'start')" }] },
    ];

   const configItems = [
      { title: "Update config", description: "View and update config, seed, or cleanup JSON", buttons: [{ text: "Update config", onClick: "openConfigDialog(event)" }] },
   ];

    const utilityItems = [
      { title: "Swagger", description: "Open API documentation", buttons: [{ text: "Swagger", href: `${baseURL}/swagger` }] },
      { title: "WMS", description: "Open WMS capabilities", buttons: [{ text: "WMS", href: `${baseURL}/wms?SERVICE=WMS&VERSION=1.3.0&REQUEST=GetCapabilities` }] },
      { title: "WFS", description: "Open WFS capabilities", buttons: [{ text: "WFS", href: `${baseURL}/wfs?SERVICE=WFS&VERSION=2.0.0&REQUEST=GetCapabilities` }] },
      { title: "WMTS", description: "Open WMTS capabilities", buttons: [{ text: "WMTS", href: `${baseURL}/wmts?SERVICE=WMTS&VERSION=1.0.0&REQUEST=GetCapabilities` }] },
      { title: "Export image", description: "Export a static map image", buttons: [{ text: "Export image", onClick: "handleExportImage(event)" }] },
      { title: "Kill server", description: "Stop the server process", buttons: [{ text: "Kill server", onClick: "handleConfig(event, 'kill')" }] },
      { title: "Restart server", description: "Restart the server process", buttons: [{ text: "Restart server", onClick: "handleConfig(event, 'restart')" }] },
      { title: "Summary service", description: "View the service summary", buttons: [{ text: "Summary service", href: `${baseURL}/summary?type=service` }] },
      { title: "Summary seed", description: "View the seed summary", buttons: [{ text: "Summary seed", href: `${baseURL}/summary?type=seed` }] },
    ];

    let syncDialogAction = "start";

    function updateSyncIDOptions() {
      const typeInput = document.getElementById("syncTypeInput");
      const idInput = document.getElementById("syncIDInput");
      const ids = syncTargets[typeInput.value] || [];

      idInput.innerHTML = '<option value="">All</option>' +
        ids.map((id) => '<option value="' + escapeAttr(id) + '">' + escapeHTML(id) + '</option>').join("");
      idInput.disabled = !typeInput.value;
    }

    function openSyncDialog(event, action) {
      event.preventDefault();
      syncDialogAction = action;

      const typeInput = document.getElementById("syncTypeInput");
      const title = action === "start" ? "Sync" : "Cancel sync";
      document.getElementById("syncDialogTitle").textContent = title;
      document.getElementById("syncSubmitButton").textContent = title;
      typeInput.innerHTML = '<option value="">All</option>' +
        Object.keys(syncTargets).sort().map((type) =>
          '<option value="' + escapeAttr(type) + '">' + escapeHTML(type) + '</option>'
        ).join("");
      typeInput.value = "";
      updateSyncIDOptions();
      document.getElementById("syncDialog").showModal();
    }

    document.getElementById("syncTypeInput").addEventListener("change", updateSyncIDOptions);
    document.getElementById("syncForm").addEventListener("submit", (event) => {
      event.preventDefault();
      const type = document.getElementById("syncTypeInput").value;
      const id = document.getElementById("syncIDInput").value;
      const query = new URLSearchParams();
      if (type) query.set("type", type);
      if (id) query.set("id", id);
      if (syncDialogAction === "start") query.set("restart", "true");

      const endpoint = baseURL + "/tasks/" +
        (syncDialogAction === "start" ? "start" : "cancel") + "?" + query;
      fetch(endpoint)
        .then((response) => {
          if (!response.ok) throw new Error("Failed to " + syncDialogAction + ": " + response.status);
          alert(syncDialogAction === "start" ? "Starting sync..." : "Canceling sync...");
          closeDialog("syncDialog");
        })
        .catch(handleError);
    });

    function loadSelectedConfig() {
      const type = document.getElementById("configTypeInput").value;
      fetch(baseURL + "/config?type=" + encodeURIComponent(type))
        .then((response) => {
          if (!response.ok) throw new Error("Failed to load " + type + " JSON: " + response.status);
          return response.json();
        })
        .then((value) => jsonEditors.selectedConfigInput.setValue(value))
        .catch(handleError);
    }

    function openConfigDialog(event) {
      event.preventDefault();
      document.getElementById("configTypeInput").value = "config";
      loadSelectedConfig();
      document.getElementById("configDialog").showModal();
    }

    document.getElementById("configTypeInput").addEventListener("change", loadSelectedConfig);
    document.getElementById("configForm").addEventListener("submit", (event) => {
      event.preventDefault();
      const type = document.getElementById("configTypeInput").value;
      const body = getJSONText("selectedConfigInput");
      if (body === null) return;

      fetch(baseURL + "/config?type=" + encodeURIComponent(type) + "&restart=true&overwrite=true", {
        method: "PUT",
        headers: { "content-type": "application/json" },
        body,
      })
        .then((response) => {
          if (!response.ok) throw new Error("Failed to update " + type + " JSON: " + response.status);
          alert("Updated " + type + " JSON.");
          closeDialog("configDialog");
        })
        .catch(handleError);
    });

   const configActions = {
      restart: { url: `${baseURL}/restart?type=restart`, message: "Server restarted successfully!" },
      kill: { url: `${baseURL}/restart?type=kill`, message: "Server killed successfully!" },
    };

    function toggleURL(id, event) {
      event.preventDefault();

      const el = document.getElementById(id);

      if (el.style.display === "none") {
        el.style.display = "inline-block";
      } else {
        el.style.display = "none";
      }
    }

    function copyToClipboard(el) {
      el.select();

      document.execCommand("copy");

      setTimeout(() => {
        el.style.display = "none";
      }, 200);
    }

    function scrollToTop(event) {
      event.preventDefault();

      window.scrollTo({
        top: 0,
        behavior: "smooth",
      });
    }

    function switchTab(event, tabId) {
      document.querySelectorAll(".tab").forEach(tab => {
        tab.classList.remove("active");
      });

      document.querySelectorAll(".tab-content").forEach(content => {
        content.classList.remove("active");
      });

      event.currentTarget.classList.add("active");

      document.getElementById(tabId).classList.add("active");

      renderContents(tabId);
    }

    const searchableTabIDs = new Set([
      "styles-tab",
      "geojsons-tab",
      "geojson_groups-tab",
      "datas-tab",
      "fonts-tab",
      "sprites-tab",
    ]);

    function addTabSearch(tabId) {
      if (!searchableTabIDs.has(tabId)) return;

      const tab = document.getElementById(tabId);
      if (tab.querySelector(".tab-search")) return;

      const search = document.createElement("div");
      search.className = "tab-search";
      search.innerHTML = '<input type="search" placeholder="Search..." aria-label="Search items" />';
      const input = search.querySelector("input");
      input.addEventListener("input", () => {
        const query = input.value.trim().toLowerCase();
        tab.querySelectorAll(".box > .item").forEach((item) => {
          item.hidden = Boolean(query) && !item.textContent.toLowerCase().includes(query);
        });
      });

      tab.prepend(search);
    }

    function renderContents(tabId) {
      const innerHTML = document.querySelector(`#${tabId}`).innerHTML.trim();

      if (tabId === "styles-tab" && !innerHTML) {
        document.querySelector("#styles-tab").innerHTML = `
          <div class="box">
            {{#each styles}}
              <div class="item">
                {{#if thumbnail}}<img src="${escapeAttr({{{js thumbnail}}})}" alt="${escapeAttr({{{js name}}})} preview" />{{else}}<img src="${emptyImageURL}" alt="${escapeAttr({{{js name}}})} preview" />{{/if}}
                <div class="details">
                  <h3 class="name">${escapeHTML({{{js name}}})}</h3>
                  <p>identifier: ${escapeHTML({{{js @key}}})}</p>
                  <p>cache: {{#if cache}}<span style="color:green;">true</span>{{else}}<span style="color:red;">false</span>{{/if}}</p>
                  <p class="services">
                    services: <a href="${baseURL}/styles/${pathSegment({{{js @key}}})}/style.json">StyleJSON</a>
                    {{#if thumbnail}}
                      | <a href="${baseURL}/styles/${pathSegment({{{js @key}}})}.json">TileJSON</a>
                      | <a href="#" data-target="${escapeAttr(domId("xyz_style", {{{js @key}}}))}" onclick="toggleURL(this.dataset.target, event)">XYZ</a>
                      <input id="${escapeAttr(domId("xyz_style", {{{js @key}}}))}" style="display:none;cursor:pointer;" type="text" value="${baseURL}/styles/${pathSegment({{{js @key}}})}/{z}/{x}/{y}.png" onclick="copyToClipboard(this)" />
                    {{/if}}
                  </p>
                </div>
                <div class="viewers">
                    <a class="btn" href="${baseURL}/styles/${pathSegment({{{js @key}}})}/?vector${escapeAttr({{{js viewer_hash}}})}">Client Render</a>
                    {{#if thumbnail}}
                      <a class="btn" href="${baseURL}/styles/${pathSegment({{{js @key}}})}/?raster${escapeAttr({{{js viewer_hash}}})}">Backend Render</a>
                      {{#if cancel_render}}
                      <a class="btn" href="#" data-id="${escapeAttr({{{js @key}}})}" onclick="handleExportRender(event, this.dataset.id, 'cancel')">Cancel Render</a>
                      {{else}}
                      <a class="btn" href="#" data-id="${escapeAttr({{{js @key}}})}" onclick="handleExportRender(event, this.dataset.id, 'export')">Export Render</a>
                      {{/if}}
                    {{/if}}
                </div>
              </div>
            {{/each}}
          </div>
        `;
      } if (tabId === "geojsons-tab" && !innerHTML) {
        document.querySelector("#geojsons-tab").innerHTML = `
          <div class="box">
            {{#each geojsons}}
              <div class="item">
                <img src="${emptyImageURL}" alt="Empty image" />
                <div class="details">
                  <h3 class="name">${escapeHTML({{{js layer}}})}</h3>
                  <p>identifier: ${escapeHTML({{{js layer}}})}</p>
                  <p>group: ${escapeHTML({{{js group}}})}</p>
                  <p>layer: ${escapeHTML({{{js layer}}})}</p>
                  <p>cache: {{#if cache}}<span style="color:green;">true</span>{{else}}<span style="color:red;">false</span>{{/if}}</p>
                  <p class="services">
                    services: <a href="${baseURL}/geojsons/${pathSegment({{{js group}}})}/${pathSegment({{{js layer}}})}.geojson">GeoJSON</a>
                    | <a href="${baseURL}/geojsons/${pathSegment({{{js group}}})}/${pathSegment({{{js layer}}})}.json">INFO</a>
                  </p>
                </div>
                <div class="viewers">
                  <a class="btn" href="${baseURL}/geojsons/${pathSegment({{{js group}}})}/${pathSegment({{{js layer}}})}/">Inspect</a>
                </div>
              </div>
            {{/each}}
          </div>
        `;
      } if (tabId === "geojson_groups-tab" && !innerHTML) {
        document.querySelector("#geojson_groups-tab").innerHTML = `
          <div class="box">
            {{#each geojson_groups}}
              <div class="item">
                <img src="${emptyImageURL}" alt="Empty image" />
                <div class="details">
                  <h3 class="name">${escapeHTML({{{js @key}}})}</h3>
                  <p>identifier: ${escapeHTML({{{js @key}}})}</p>
                  <p class="services">
                    services: <a href="${baseURL}/geojsons/${pathSegment({{{js @key}}})}.json">INFO</a>
                  </p>
                </div>
                <div class="viewers">
                  <a class="btn" href="${baseURL}/geojsons/${pathSegment({{{js @key}}})}/">Inspect</a>
                </div>
              </div>
            {{/each}}
          </div>
        `;
      } else if (tabId === "datas-tab" && !innerHTML) {
        document.querySelector("#datas-tab").innerHTML = `
          <div class="box">
            {{#each datas}}
              <div class="item">
                {{#if thumbnail}}<img src="${escapeAttr({{{js thumbnail}}})}" alt="${escapeAttr({{{js name}}})} preview" />{{else}}<img src="${emptyImageURL}" alt="${escapeAttr({{{js name}}})} preview" />{{/if}}
                <div class="details">
                  <h3 class="name">${escapeHTML({{{js name}}})}</h3>
                  <p>identifier: ${escapeHTML({{{js @key}}})}</p>
                  <p>type: {{#if thumbnail}}raster{{else}}vector{{/if}} | ext: ${escapeHTML({{{js source_type}}})}</p>
                  <p>cache: {{#if cache}}<span style="color:green;">true</span>{{else}}<span style="color:red;">false</span>{{/if}}</p>
                  <p class="services">
                    services: <a href="${baseURL}/datas/${pathSegment({{{js @key}}})}.json">TileJSON</a>
                      | <a href="#" data-target="${escapeAttr(domId("xyz_data", {{{js @key}}}))}" onclick="toggleURL(this.dataset.target, event)">XYZ</a>
                      <input id="${escapeAttr(domId("xyz_data", {{{js @key}}}))}" style="display:none;cursor:pointer;" type="text" value="${baseURL}/datas/${pathSegment({{{js @key}}})}/{z}/{x}/{y}.${pathSegment({{{js format}}})}" onclick="copyToClipboard(this)" />
                  </p>
                </div>
                <div class="viewers">
                  {{#if thumbnail}}
                  <a class="btn" href="${baseURL}/datas/${pathSegment({{{js @key}}})}/${escapeAttr({{{js viewer_hash}}})}">View</a>
                  {{else}}
                  <a class="btn" href="${baseURL}/datas/${pathSegment({{{js @key}}})}/${escapeAttr({{{js viewer_hash}}})}">Inspect</a>
                  {{/if}}
                  {{#if cancel_export}}
                  <a class="btn" href="#" data-id="${escapeAttr({{{js @key}}})}" onclick="handleExportData(event, this.dataset.id, 'cancel')">Cancel Export</a>
                  {{else}}
                  <a class="btn" href="#" data-id="${escapeAttr({{{js @key}}})}" onclick="handleExportData(event, this.dataset.id, 'export')">Export Data</a>
                  {{/if}}
                </div>
              </div>
            {{/each}}
          </div>
        `;
      } else if (tabId === "fonts-tab" && !innerHTML) {
        document.querySelector("#fonts-tab").innerHTML = `
          <div class="box">
            {{#each fonts}}
              <div class="item">
                <img src="${emptyImageURL}" alt="Empty image" />
                <div class="details">
                  <h3 class="name">${escapeHTML({{{js @key}}})}</h3>
                  <p>identifier: ${escapeHTML({{{js @key}}})}</p>
                  <p>cache: {{#if cache}}<span style="color:green;">true</span>{{else}}<span style="color:red;">false</span>{{/if}}</p>
                  <p class="services">
                    services: <a href="#" data-target="${escapeAttr(domId("font", {{{js @key}}}))}" onclick="toggleURL(this.dataset.target, event)">URL</a>
                    <input id="${escapeAttr(domId("font", {{{js @key}}}))}" style="display:none;cursor:pointer;" type="text" value="${baseURL}/fonts/${pathSegment({{{js @key}}})}/{range}.pbf" onclick="copyToClipboard(this)" />
                  </p>
                </div>
              </div>
            {{/each}}
          </div>
        `;
      } else if (tabId === "sprites-tab" && !innerHTML) {
        document.querySelector("#sprites-tab").innerHTML = `
          <div class="box">
            {{#each sprites}}
              <div class="item">
                <img src="${baseURL}/sprites/${pathSegment({{{js @key}}})}/sprite.png" alt="${escapeAttr({{{js @key}}})} preview" />
                <div class="details">
                  <h3 class="name">${escapeHTML({{{js @key}}})}</h3>
                  <p>identifier: ${escapeHTML({{{js @key}}})}</p>
                  <p>cache: {{#if cache}}<span style="color:green;">true</span>{{else}}<span style="color:red;">false</span>{{/if}}</p>
                  <p class="services">
                    services: <a href="${baseURL}/sprites/${pathSegment({{{js @key}}})}/sprite.json">JSON</a>
                    | <a href="${baseURL}/sprites/${pathSegment({{{js @key}}})}/sprite.png">PNG</a>
                    | <a href="#" data-target="${escapeAttr(domId("sprite", {{{js @key}}}))}" onclick="toggleURL(this.dataset.target, event)">URL</a>
                    <input id="${escapeAttr(domId("sprite", {{{js @key}}}))}" style="display:none;cursor:pointer;" type="text" value="${baseURL}/sprites/${pathSegment({{{js @key}}})}/sprite" onclick="copyToClipboard(this)" />
                  </p>
                </div>
              </div>
            {{/each}}
          </div>
        `;
      } else if (tabId === "sync-tab" && !innerHTML) {
        document.querySelector("#sync-tab").innerHTML = renderStaticBox(syncItems);
      } else if (tabId === "configs-tab" && !innerHTML) {
        document.querySelector("#configs-tab").innerHTML = renderStaticBox(configItems);
      } else if (tabId === "utility-tab" && !innerHTML) {
        document.querySelector("#utility-tab").innerHTML = renderStaticBox(utilityItems);
      }

      addTabSearch(tabId);
    }

    function handleError(error) {
      if (error.response) {
        alert(`Error: Status code: ${error.response.status} - ${error.response.statusText}`);
      } else if (error.request) {
        alert("No response received");
      } else {
        alert(`Error: ${error.message}`);
      }
    }

    function handleConfig(event, action) {
      event.preventDefault();

      const configAction = configActions[action];

      if (configAction) {
        requestGET(configAction.url, configAction.message);
      }
    }

    function handleExportRender(event, styleID, action) {
      event.preventDefault();

      if (action === "export") {
        document.getElementById("exportRenderDialog").showModal();

        document.getElementById("exportRenderForm").onsubmit = (event) => {
          event.preventDefault();
          const body = getJSONText("exportRenderInput");
          if (body === null) return;

          fetch(`${baseURL}/exports/style-render/${styleID}`, {
            method: "POST",
            headers: {
              "content-type": "application/json",
            },
            body
          })
            .then(() => {
              alert("Exporting render style...");

              closeDialog("exportRenderDialog");
            })
            .catch(handleError);
        }
      } else if (action === "cancel") {
        let maxRetries = 5;

        function tryFetch() {
          fetch(`${baseURL}/exports/style-render/${styleID}?cancel=true`, {
            method: "GET",
          })
            .then(() => alert("Canceling render style..."))
            .catch(handleError);
        }

        tryFetch();
      }
    }

    function handleExportImage(event) {
      event.preventDefault();

      document.getElementById("exportImageDialog").showModal();

        document.getElementById("exportImageForm").onsubmit = (event) => {
          event.preventDefault();
          const body = getJSONText("exportImageInput");
          if (body === null) return;

          fetch(`${baseURL}/renders/stylejson`, {
          method: "POST",
          headers: {
            "content-type": "application/json",
          },
            body
        })
          .then(async (response) => {
            const contentDisposition = response.headers.get("content-disposition");

            if (contentDisposition) {
              const url = window.URL.createObjectURL(await response.blob());

              const a = document.createElement("a");
              a.href = url;
              a.download = contentDisposition.split("filename=")[1].replace(/"/g, "");
              document.body.appendChild(a);
              a.click();
              a.remove();

              window.URL.revokeObjectURL(url);
            } else {
              alert(JSON.stringify(await response.json(), null, 2));
            }

            closeDialog("exportImageDialog");
          })
          .catch(handleError);
      }
    }

    function handleExportData(event, dataID, action) {
      event.preventDefault();

      if (action === "export") {
        document.getElementById("exportDataDialog").showModal();

        document.getElementById("exportDataForm").onsubmit = (event) => {
          event.preventDefault();
          const body = getJSONText("exportDataInput");
          if (body === null) return;

          fetch(`${baseURL}/exports/data/${dataID}`, {
            method: "POST",
            headers: {
              "content-type": "application/json",
            },
            body
          })
            .then(() => {
              alert("Exporting data...");

              closeDialog("exportDataDialog");
            })
            .catch(handleError);
        }
      } else if (action === "cancel") {
        let maxRetries = 5;

        function tryFetch() {
          fetch(`${baseURL}/exports/data/${dataID}?cancel=true`, {
            method: "GET",
          })
            .then(() => alert("Canceling export data..."))
            .catch(handleError);
        }

        tryFetch();
      }
    }

    function closeDialog(dialog) {
      document.getElementById(dialog).close();
    }

    window.onload = function () {
      renderContents("styles-tab");
    };

    window.addEventListener("scroll", () => {
      const backToTopButton = document.querySelector(".back-to-top");

      if (window.scrollY > 200) {
        backToTopButton.style.display = "flex";
      } else {
        backToTopButton.style.display = "none";
      }
    });
  </script>
</body>

</html>
