{
  "type": "object",
  "propertyNames": {
    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._ -]*$"
  },
  "additionalProperties": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "height": {
        "type": "integer",
        "minimum": 1
      },
      "width": {
        "type": "integer",
        "minimum": 1
      },
      "x": {
        "type": "integer",
        "minimum": 0
      },
      "y": {
        "type": "integer",
        "minimum": 0
      },
      "pixelRatio": {
        "type": "number",
        "minimum": 1
      }
    },
    "required": [
      "height",
      "pixelRatio",
      "width",
      "x",
      "y"
    ]
  }
}