{
  "name": "ms-tile-server",
  "description": "Vector/Raster tile server for serving/caching xyz/wmts tiles",
  "version": "0.0.17",
  "license": "MIT",
  "author": "Huy Le <lqh23072000@gmail.com>",
  "keywords": [
    "ms-tile-server"
  ],
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "bin": {
    "tile-server": "./entrypoint.sh"
  },
  "scripts": {
    "server": "./entrypoint.sh",
    "test": "node --test test/*.test.js",
    "lint:check": "eslint \"src/**/*.js\"",
    "check": "npm run lint:check && npm test",
    "benchmark:batch": "node scripts/benchmark_batch.js",
    "lint:fix": "eslint \"src/**/*.{json,js,ts,tsx,css}\" --fix",
    "format": "prettier --write \"src/**/*.{json,js,ts,tsx,css}\"",
    "newest": "npx npm-check-updates -u && npx json -I -f package.json -e \"if(this.dependencies){Object.keys(this.dependencies).forEach(k=>this.dependencies[k]=this.dependencies[k].replace(/^[~^]/,''))} if(this.devDependencies){Object.keys(this.devDependencies).forEach(k=>this.devDependencies[k]=this.devDependencies[k].replace(/^[~^]/,''))}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{json,js,ts,tsx,css}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@maplibre/maplibre-gl-native": "6.4.1",
    "@maplibre/maplibre-gl-style-spec": "26.2.1",
    "@socket.io/cluster-adapter": "0.3.0",
    "@socket.io/sticky": "2.0.1",
    "ajv": "8.20.0",
    "archiver": "8.0.0",
    "axios": "1.19.0",
    "better-sqlite3": "13.0.3",
    "cache-manager": "7.2.9",
    "chokidar": "5.0.0",
    "cors": "2.8.6",
    "express": "5.2.1",
    "generic-pool": "3.9.0",
    "handlebars": "4.7.9",
    "http-status-codes": "2.3.0",
    "jspdf": "4.2.1",
    "mime": "4.1.0",
    "nanoid": "6.0.1",
    "node-cron": "4.6.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "pmtiles": "4.5.0",
    "proj4": "2.21.0",
    "prom-client": "15.1.3",
    "protocol-buffers": "5.0.0",
    "sharp": "0.35.3",
    "socket.io": "4.8.3",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "eslint": "10.9.0",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6"
  },
  "engines": {
    "node": ">=22 <=24"
  }
}
